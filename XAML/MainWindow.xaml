<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PowerShell Report Builder"
    Height="800"
    Width="1200"
    WindowStartupLocation="CenterScreen">

    <!-- Fluent theme is applied via ThemeMode in code-behind (PowerShell 7.5+ / .NET 9) -->
    <!-- No custom styles needed - using default Fluent theme styles -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem x:Name="MenuNew" Header="_New Report" InputGestureText="Ctrl+N"/>
                <MenuItem x:Name="MenuOpen" Header="_Open..." InputGestureText="Ctrl+O"/>
                <MenuItem x:Name="MenuSave" Header="_Save" InputGestureText="Ctrl+S"/>
                <MenuItem x:Name="MenuSaveAs" Header="Save _As..."/>
                <Separator/>
                <MenuItem x:Name="MenuExportCode" Header="Export _PowerShell Code"/>
                <MenuItem x:Name="MenuExportHtml" Header="Export as _HTML"/>
                <Separator/>
                <MenuItem x:Name="MenuExit" Header="E_xit" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="MenuUndo" Header="_Undo" InputGestureText="Ctrl+Z"/>
                <MenuItem x:Name="MenuRedo" Header="_Redo" InputGestureText="Ctrl+Y"/>
            </MenuItem>
            <MenuItem Header="_Data">
                <MenuItem x:Name="MenuAddDataSource" Header="_Add Data Source"/>
                <MenuItem x:Name="MenuManageDataSources" Header="_Manage Data Sources"/>
                <Separator/>
                <MenuItem x:Name="MenuRefreshData" Header="_Refresh Data"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="MenuPreview" Header="_Preview Report" InputGestureText="F5"/>
                <MenuItem x:Name="MenuShowCode" Header="Show Generated _Code"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem x:Name="MenuHelp" Header="_Documentation"/>
                <MenuItem x:Name="MenuAbout" Header="_About"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1">
            <Button x:Name="BtnNew" ToolTip="New Report" Padding="10,5" Margin="2">📄 New</Button>
            <Button x:Name="BtnOpen" ToolTip="Open" Padding="10,5" Margin="2">📂 Open</Button>
            <Button x:Name="BtnSave" ToolTip="Save" Padding="10,5" Margin="2">💾 Save</Button>
            <Separator/>
            <Button x:Name="BtnAddDataSource" ToolTip="Add Data Source" Padding="10,5" Margin="2">🗃️ Source</Button>
            <Separator/>
            <Button x:Name="BtnPreview" ToolTip="Preview (F5)" Padding="10,5" Margin="2">▶️ Preview</Button>
            <Button x:Name="BtnExportHtml" ToolTip="Export HTML" Padding="10,5" Margin="2">📤 Export</Button>
        </ToolBar>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Elements Toolbox & Tree -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Elements Toolbox Header -->
                <Border Grid.Row="0" Padding="10">
                    <TextBlock Text="📦 Elements" FontSize="14" FontWeight="SemiBold"/>
                </Border>

                <!-- Elements Toolbox -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ElementsToolbox" Margin="5">
                        <Button x:Name="BtnAddTab" HorizontalAlignment="Stretch" Padding="10,5" Margin="2">📑 Tab</Button>
                        <Button x:Name="BtnAddSection" HorizontalAlignment="Stretch" Padding="10,5" Margin="2">📦 Section</Button>
                        <Button x:Name="BtnAddPanel" HorizontalAlignment="Stretch" Padding="10,5" Margin="2">🗂️ Panel</Button>
                        <Button x:Name="BtnAddTable" HorizontalAlignment="Stretch" Padding="10,5" Margin="2">📊 Table</Button>
                        <Button x:Name="BtnAddChart" HorizontalAlignment="Stretch" Padding="10,5" Margin="2">📈 Chart</Button>
                        <Button x:Name="BtnAddText" HorizontalAlignment="Stretch" Padding="10,5" Margin="2">📝 Text</Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Report Structure Header -->
                <Border Grid.Row="2" Padding="10">
                    <TextBlock Text="🏗️ Report Structure" FontSize="14" FontWeight="SemiBold"/>
                </Border>

                <!-- Report Structure Tree -->
                <TreeView x:Name="ReportTreeView" Grid.Row="3" BorderThickness="0" Margin="5"/>
            </Grid>

            <!-- Left Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- Center Panel - Visual Designer / Preview -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tab Control for Designer/Preview/Code -->
                <TabControl Grid.Row="0" Grid.RowSpan="2" x:Name="MainTabControl" BorderThickness="0">
                    <!-- Designer Tab -->
                    <TabItem Header="🎨 Designer">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Report Title -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                                <Label Content="Report Title:"/>
                                <TextBox x:Name="TxtReportTitle" Width="300" Padding="5" Margin="2" Text="New Report"/>
                            </StackPanel>

                            <!-- Design Canvas -->
                            <Border Grid.Row="1" Margin="10" CornerRadius="5" BorderThickness="1" BorderBrush="Gray">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <Canvas x:Name="DesignCanvas" Width="800" Height="600">
                                        <TextBlock Canvas.Left="300" Canvas.Top="280" Text="Drag elements here" Foreground="Gray" FontSize="16"/>
                                    </Canvas>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Preview Tab -->
                    <TabItem Header="👁️ Preview">
                        <Grid>
                            <WebBrowser x:Name="PreviewBrowser"/>
                        </Grid>
                    </TabItem>

                    <!-- Code Tab -->
                    <TabItem Header="💻 Generated Code">
                        <Grid>
                            <TextBox x:Name="TxtGeneratedCode"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="10"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Right Splitter -->
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

            <!-- Right Panel - Properties -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- Properties Header -->
                <Border Grid.Row="0" Padding="10">
                    <TextBlock Text="⚙️ Properties" FontSize="14" FontWeight="SemiBold"/>
                </Border>

                <!-- Properties Panel -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropertiesPanel" Margin="10">
                        <TextBlock Text="Select an element to view its properties" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Data Sources Header -->
                <Border Grid.Row="2" Padding="10">
                    <TextBlock Text="🗃️ Data Sources" FontSize="14" FontWeight="SemiBold"/>
                </Border>

                <!-- Data Sources List -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="DataSourcesList" Grid.Row="0" BorderThickness="0" Margin="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <Button x:Name="BtnAddDataSourcePanel" Content="➕" Padding="10,5" Margin="2"/>
                        <Button x:Name="BtnEditDataSource" Content="✏️" Padding="10,5" Margin="2"/>
                        <Button x:Name="BtnRemoveDataSource" Content="🗑️" Padding="10,5" Margin="2"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusElements" Text="Elements: 0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
