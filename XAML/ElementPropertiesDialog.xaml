<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Element Properties"
    Height="450"
    Width="400"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize">

    <!-- Fluent theme is applied via ThemeMode in code-behind (PowerShell 7.5+ / .NET 9) -->
    <!-- No custom styles needed - using default Fluent theme styles -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock x:Name="TxtElementIcon" Text="📦" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="TxtElementType" Text="Element Properties" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Properties Panel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PropertiesStack">

                <!-- Common Properties -->
                <Label Content="Name:" Margin="5,5,5,0"/>
                <TextBox x:Name="TxtElementName" Padding="8" Margin="5"/>

                <!-- Tab Properties -->
                <StackPanel x:Name="TabProperties" Visibility="Collapsed">
                    <Label Content="Tab Name:" Margin="5,5,5,0"/>
                    <TextBox x:Name="TxtTabName" Padding="8" Margin="5"/>

                    <Label Content="Icon (FontAwesome Solid):" Margin="5,5,5,0"/>
                    <ComboBox x:Name="CmbTabIcon" Padding="8" Margin="5">
                        <ComboBoxItem Content="(None)" Tag=""/>
                        <ComboBoxItem Content="home" Tag="home"/>
                        <ComboBoxItem Content="chart-bar" Tag="chart-bar"/>
                        <ComboBoxItem Content="table" Tag="table"/>
                        <ComboBoxItem Content="users" Tag="users"/>
                        <ComboBoxItem Content="cog" Tag="cog"/>
                        <ComboBoxItem Content="file" Tag="file"/>
                        <ComboBoxItem Content="folder" Tag="folder"/>
                    </ComboBox>
                </StackPanel>

                <!-- Section Properties -->
                <StackPanel x:Name="SectionProperties" Visibility="Collapsed">
                    <Label Content="Header Text:" Margin="5,5,5,0"/>
                    <TextBox x:Name="TxtSectionHeader" Padding="8" Margin="5"/>

                    <CheckBox x:Name="ChkSectionCollapse" Content="Collapsible" Margin="5"/>
                    <CheckBox x:Name="ChkSectionInvisible" Content="Invisible (no border)" Margin="5"/>
                </StackPanel>

                <!-- Panel Properties -->
                <StackPanel x:Name="PanelProperties" Visibility="Collapsed">
                    <Label Content="Background Color:" Margin="5,5,5,0"/>
                    <ComboBox x:Name="CmbPanelBgColor" Padding="8" Margin="5">
                        <ComboBoxItem Content="(Default)" Tag=""/>
                        <ComboBoxItem Content="White" Tag="White"/>
                        <ComboBoxItem Content="LightGray" Tag="LightGray"/>
                        <ComboBoxItem Content="LightBlue" Tag="LightBlue"/>
                        <ComboBoxItem Content="LightGreen" Tag="LightGreen"/>
                        <ComboBoxItem Content="LightYellow" Tag="LightYellow"/>
                    </ComboBox>
                </StackPanel>

                <!-- Table Properties -->
                <StackPanel x:Name="TableProperties" Visibility="Collapsed">
                    <Label Content="Data Source:" Margin="5,5,5,0"/>
                    <ComboBox x:Name="CmbTableDataSource" Padding="8" Margin="5"/>

                    <CheckBox x:Name="ChkTableHideFooter" Content="Hide Footer" Margin="5" IsChecked="True"/>
                    <CheckBox x:Name="ChkTableDisablePaging" Content="Disable Paging" Margin="5"/>
                    <CheckBox x:Name="ChkTableDisableSearch" Content="Disable Search" Margin="5"/>
                </StackPanel>

                <!-- Chart Properties -->
                <StackPanel x:Name="ChartProperties" Visibility="Collapsed">
                    <Label Content="Chart Title:" Margin="5,5,5,0"/>
                    <TextBox x:Name="TxtChartTitle" Padding="8" Margin="5"/>

                    <Label Content="Chart Type:" Margin="5,5,5,0"/>
                    <ComboBox x:Name="CmbChartType" Padding="8" Margin="5">
                        <ComboBoxItem Content="Bar" Tag="Bar" IsSelected="True"/>
                        <ComboBoxItem Content="Pie" Tag="Pie"/>
                        <ComboBoxItem Content="Line" Tag="Line"/>
                        <ComboBoxItem Content="Donut" Tag="Donut"/>
                    </ComboBox>

                    <Label Content="Data Source:" Margin="5,5,5,0"/>
                    <ComboBox x:Name="CmbChartDataSource" Padding="8" Margin="5"/>
                </StackPanel>

                <!-- Text Properties -->
                <StackPanel x:Name="TextProperties" Visibility="Collapsed">
                    <Label Content="Text:" Margin="5,5,5,0"/>
                    <TextBox x:Name="TxtTextContent" Padding="8" Margin="5" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <Label Content="Color:" Margin="5,5,5,0"/>
                    <ComboBox x:Name="CmbTextColor" Padding="8" Margin="5">
                        <ComboBoxItem Content="(Default)" Tag=""/>
                        <ComboBoxItem Content="Black" Tag="Black"/>
                        <ComboBoxItem Content="Blue" Tag="Blue"/>
                        <ComboBoxItem Content="Red" Tag="Red"/>
                        <ComboBoxItem Content="Green" Tag="Green"/>
                        <ComboBoxItem Content="Gray" Tag="Gray"/>
                    </ComboBox>

                    <Label Content="Alignment:" Margin="5,5,5,0"/>
                    <ComboBox x:Name="CmbTextAlignment" Padding="8" Margin="5">
                        <ComboBoxItem Content="Left" Tag="left" IsSelected="True"/>
                        <ComboBoxItem Content="Center" Tag="center"/>
                        <ComboBoxItem Content="Right" Tag="right"/>
                    </ComboBox>

                    <Label Content="Font Size:" Margin="5,5,5,0"/>
                    <ComboBox x:Name="CmbTextFontSize" Padding="8" Margin="5">
                        <ComboBoxItem Content="(Default)" Tag=""/>
                        <ComboBoxItem Content="10px" Tag="10px"/>
                        <ComboBoxItem Content="12px" Tag="12px"/>
                        <ComboBoxItem Content="14px" Tag="14px"/>
                        <ComboBoxItem Content="16px" Tag="16px"/>
                        <ComboBoxItem Content="18px" Tag="18px"/>
                        <ComboBoxItem Content="24px" Tag="24px"/>
                    </ComboBox>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnCancelProps" Content="Cancel" Padding="15,8" Margin="5"/>
            <Button x:Name="BtnSaveProps" Content="✓ Apply" Padding="15,8" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
