<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Element Properties"
    Height="450"
    Width="400"
    WindowStartupLocation="CenterOwner"
    Background="#1E1E1E"
    ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1084D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="DarkLabel" TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="5,5,5,0"/>
        </Style>

        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock x:Name="TxtElementIcon" Text="📦" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="TxtElementType" Text="Element Properties" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Properties Panel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PropertiesStack">

                <!-- Common Properties -->
                <Label Content="Name:" Style="{StaticResource DarkLabel}"/>
                <TextBox x:Name="TxtElementName" Style="{StaticResource DarkTextBox}"/>

                <!-- Tab Properties -->
                <StackPanel x:Name="TabProperties" Visibility="Collapsed">
                    <Label Content="Tab Name:" Style="{StaticResource DarkLabel}"/>
                    <TextBox x:Name="TxtTabName" Style="{StaticResource DarkTextBox}"/>

                    <Label Content="Icon (FontAwesome Solid):" Style="{StaticResource DarkLabel}"/>
                    <ComboBox x:Name="CmbTabIcon" Style="{StaticResource DarkComboBox}">
                        <ComboBoxItem Content="(None)" Tag=""/>
                        <ComboBoxItem Content="home" Tag="home"/>
                        <ComboBoxItem Content="chart-bar" Tag="chart-bar"/>
                        <ComboBoxItem Content="table" Tag="table"/>
                        <ComboBoxItem Content="users" Tag="users"/>
                        <ComboBoxItem Content="cog" Tag="cog"/>
                        <ComboBoxItem Content="file" Tag="file"/>
                        <ComboBoxItem Content="folder" Tag="folder"/>
                    </ComboBox>
                </StackPanel>

                <!-- Section Properties -->
                <StackPanel x:Name="SectionProperties" Visibility="Collapsed">
                    <Label Content="Header Text:" Style="{StaticResource DarkLabel}"/>
                    <TextBox x:Name="TxtSectionHeader" Style="{StaticResource DarkTextBox}"/>

                    <CheckBox x:Name="ChkSectionCollapse" Content="Collapsible" Style="{StaticResource DarkCheckBox}"/>
                    <CheckBox x:Name="ChkSectionInvisible" Content="Invisible (no border)" Style="{StaticResource DarkCheckBox}"/>
                </StackPanel>

                <!-- Panel Properties -->
                <StackPanel x:Name="PanelProperties" Visibility="Collapsed">
                    <Label Content="Background Color:" Style="{StaticResource DarkLabel}"/>
                    <ComboBox x:Name="CmbPanelBgColor" Style="{StaticResource DarkComboBox}">
                        <ComboBoxItem Content="(Default)" Tag=""/>
                        <ComboBoxItem Content="White" Tag="White"/>
                        <ComboBoxItem Content="LightGray" Tag="LightGray"/>
                        <ComboBoxItem Content="LightBlue" Tag="LightBlue"/>
                        <ComboBoxItem Content="LightGreen" Tag="LightGreen"/>
                        <ComboBoxItem Content="LightYellow" Tag="LightYellow"/>
                    </ComboBox>
                </StackPanel>

                <!-- Table Properties -->
                <StackPanel x:Name="TableProperties" Visibility="Collapsed">
                    <Label Content="Data Source:" Style="{StaticResource DarkLabel}"/>
                    <ComboBox x:Name="CmbTableDataSource" Style="{StaticResource DarkComboBox}"/>

                    <CheckBox x:Name="ChkTableHideFooter" Content="Hide Footer" Style="{StaticResource DarkCheckBox}" IsChecked="True"/>
                    <CheckBox x:Name="ChkTableDisablePaging" Content="Disable Paging" Style="{StaticResource DarkCheckBox}"/>
                    <CheckBox x:Name="ChkTableDisableSearch" Content="Disable Search" Style="{StaticResource DarkCheckBox}"/>
                </StackPanel>

                <!-- Chart Properties -->
                <StackPanel x:Name="ChartProperties" Visibility="Collapsed">
                    <Label Content="Chart Title:" Style="{StaticResource DarkLabel}"/>
                    <TextBox x:Name="TxtChartTitle" Style="{StaticResource DarkTextBox}"/>

                    <Label Content="Chart Type:" Style="{StaticResource DarkLabel}"/>
                    <ComboBox x:Name="CmbChartType" Style="{StaticResource DarkComboBox}">
                        <ComboBoxItem Content="Bar" Tag="Bar" IsSelected="True"/>
                        <ComboBoxItem Content="Pie" Tag="Pie"/>
                        <ComboBoxItem Content="Line" Tag="Line"/>
                        <ComboBoxItem Content="Donut" Tag="Donut"/>
                    </ComboBox>

                    <Label Content="Data Source:" Style="{StaticResource DarkLabel}"/>
                    <ComboBox x:Name="CmbChartDataSource" Style="{StaticResource DarkComboBox}"/>
                </StackPanel>

                <!-- Text Properties -->
                <StackPanel x:Name="TextProperties" Visibility="Collapsed">
                    <Label Content="Text:" Style="{StaticResource DarkLabel}"/>
                    <TextBox x:Name="TxtTextContent" Style="{StaticResource DarkTextBox}" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <Label Content="Color:" Style="{StaticResource DarkLabel}"/>
                    <ComboBox x:Name="CmbTextColor" Style="{StaticResource DarkComboBox}">
                        <ComboBoxItem Content="(Default)" Tag=""/>
                        <ComboBoxItem Content="Black" Tag="Black"/>
                        <ComboBoxItem Content="Blue" Tag="Blue"/>
                        <ComboBoxItem Content="Red" Tag="Red"/>
                        <ComboBoxItem Content="Green" Tag="Green"/>
                        <ComboBoxItem Content="Gray" Tag="Gray"/>
                    </ComboBox>

                    <Label Content="Alignment:" Style="{StaticResource DarkLabel}"/>
                    <ComboBox x:Name="CmbTextAlignment" Style="{StaticResource DarkComboBox}">
                        <ComboBoxItem Content="Left" Tag="left" IsSelected="True"/>
                        <ComboBoxItem Content="Center" Tag="center"/>
                        <ComboBoxItem Content="Right" Tag="right"/>
                    </ComboBox>

                    <Label Content="Font Size:" Style="{StaticResource DarkLabel}"/>
                    <ComboBox x:Name="CmbTextFontSize" Style="{StaticResource DarkComboBox}">
                        <ComboBoxItem Content="(Default)" Tag=""/>
                        <ComboBoxItem Content="10px" Tag="10px"/>
                        <ComboBoxItem Content="12px" Tag="12px"/>
                        <ComboBoxItem Content="14px" Tag="14px"/>
                        <ComboBoxItem Content="16px" Tag="16px"/>
                        <ComboBoxItem Content="18px" Tag="18px"/>
                        <ComboBoxItem Content="24px" Tag="24px"/>
                    </ComboBox>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnCancelProps" Content="Cancel" Style="{StaticResource DarkButton}"/>
            <Button x:Name="BtnSaveProps" Content="✓ Apply" Style="{StaticResource AccentButton}"/>
        </StackPanel>
    </Grid>
</Window>
