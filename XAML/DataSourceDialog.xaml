<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Data Source"
    Height="500"
    Width="500"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize">

    <!-- Fluent theme is applied via ThemeMode in code-behind (PowerShell 7.5+ / .NET 9) -->
    <!-- No custom styles needed - using default Fluent theme styles -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="🗃️ New Data Source" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>

        <!-- Common Fields -->
        <StackPanel Grid.Row="1">
            <Label Content="Source Name:" Margin="5,5,5,0"/>
            <TextBox x:Name="TxtDataSourceName" Padding="8" Margin="5" Text="New Source"/>

            <Label Content="Source Type:" Margin="5,5,5,0"/>
            <ComboBox x:Name="CmbDataSourceType" Padding="8" Margin="5">
                <ComboBoxItem Content="📄 CSV File" Tag="CSV" IsSelected="True"/>
                <ComboBoxItem Content="📋 JSON File" Tag="JSON"/>
                <ComboBoxItem Content="🗃️ SQL Server Database" Tag="SQL"/>
                <ComboBoxItem Content="☁️ Microsoft Graph" Tag="Graph"/>
                <ComboBoxItem Content="✏️ Manual Entry" Tag="Manual"/>
            </ComboBox>
        </StackPanel>

        <!-- Dynamic Configuration Panel -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,10">
            <StackPanel x:Name="ConfigPanel">

                <!-- CSV Configuration -->
                <StackPanel x:Name="CsvConfig" Visibility="Visible">
                    <Label Content="CSV File Path:" Margin="5,5,5,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCsvPath" Grid.Column="0" Padding="8" Margin="5"/>
                        <Button x:Name="BtnBrowseCsv" Grid.Column="1" Content="📂" Width="40" Padding="10,5" Margin="5"/>
                    </Grid>
                    <Label Content="Delimiter:" Margin="5,5,5,0"/>
                    <ComboBox x:Name="CmbCsvDelimiter" Padding="8" Margin="5">
                        <ComboBoxItem Content="Comma (,)" Tag="," IsSelected="True"/>
                        <ComboBoxItem Content="Semicolon (;)" Tag=";"/>
                        <ComboBoxItem Content="Tab" Tag="&#x9;"/>
                        <ComboBoxItem Content="Pipe (|)" Tag="|"/>
                    </ComboBox>
                </StackPanel>

                <!-- JSON Configuration -->
                <StackPanel x:Name="JsonConfig" Visibility="Collapsed">
                    <Label Content="JSON File Path:" Margin="5,5,5,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtJsonPath" Grid.Column="0" Padding="8" Margin="5"/>
                        <Button x:Name="BtnBrowseJson" Grid.Column="1" Content="📂" Width="40" Padding="10,5" Margin="5"/>
                    </Grid>
                </StackPanel>

                <!-- SQL Configuration -->
                <StackPanel x:Name="SqlConfig" Visibility="Collapsed">
                    <Label Content="SQL Server:" Margin="5,5,5,0"/>
                    <TextBox x:Name="TxtSqlServer" Padding="8" Margin="5" Text="localhost"/>

                    <Label Content="Database:" Margin="5,5,5,0"/>
                    <TextBox x:Name="TxtSqlDatabase" Padding="8" Margin="5"/>

                    <CheckBox x:Name="ChkSqlIntegrated" Content="Windows Integrated Authentication" Margin="5" IsChecked="True"/>

                    <StackPanel x:Name="SqlCredentials" Visibility="Collapsed">
                        <Label Content="Username:" Margin="5,5,5,0"/>
                        <TextBox x:Name="TxtSqlUsername" Padding="8" Margin="5"/>

                        <Label Content="Password:" Margin="5,5,5,0"/>
                        <PasswordBox x:Name="TxtSqlPassword" Padding="8" Margin="5"/>
                    </StackPanel>

                    <Label Content="SQL Query:" Margin="5,5,5,0"/>
                    <TextBox x:Name="TxtSqlQuery" Padding="8" Margin="5" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="SELECT * FROM "/>
                </StackPanel>

                <!-- Graph Configuration -->
                <StackPanel x:Name="GraphConfig" Visibility="Collapsed">
                    <Label Content="Microsoft Graph Endpoint:" Margin="5,5,5,0"/>
                    <TextBox x:Name="TxtGraphEndpoint" Padding="8" Margin="5" Text="https://graph.microsoft.com/v1.0/"/>

                    <TextBlock Text="ℹ️ Make sure you are connected to Microsoft Graph with Connect-MgGraph before using this source." Foreground="Orange" TextWrapping="Wrap" Margin="5"/>

                    <Label Content="Common Endpoints:" Margin="5,5,5,0"/>
                    <ComboBox x:Name="CmbGraphPresets" Padding="8" Margin="5">
                        <ComboBoxItem Content="-- Select a preset --"/>
                        <ComboBoxItem Content="Users" Tag="https://graph.microsoft.com/v1.0/users"/>
                        <ComboBoxItem Content="Groups" Tag="https://graph.microsoft.com/v1.0/groups"/>
                        <ComboBoxItem Content="Applications" Tag="https://graph.microsoft.com/v1.0/applications"/>
                        <ComboBoxItem Content="Devices" Tag="https://graph.microsoft.com/v1.0/devices"/>
                    </ComboBox>
                </StackPanel>

                <!-- Manual Configuration -->
                <StackPanel x:Name="ManualConfig" Visibility="Collapsed">
                    <Label Content="Data (JSON format):" Margin="5,5,5,0"/>
                    <TextBox x:Name="TxtManualData" Padding="8" Margin="5" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="[]"/>
                    <TextBlock Text="ℹ️ Enter data in JSON array format." Foreground="Gray" Margin="5"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnTestConnection" Content="🔍 Test" Padding="15,8" Margin="5"/>
            <Button x:Name="BtnCancel" Content="Cancel" Padding="15,8" Margin="5"/>
            <Button x:Name="BtnSaveDataSource" Content="✓ Add" Padding="15,8" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
